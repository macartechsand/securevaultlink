{
  "name": "web-saas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "build:ext": "tsc -p extension/tsconfig.json && vite build -c extension/vite.config.ts",
    "build:ext:test": "vite build -c extension/vite.config.ts --mode test-hosts",
    "test:ext:e2e": "vitest run -c extension/e2e/vitest.config.ts",
    "build:mobile": "tsc -b && vite build --outDir dist-mobile --emptyOutDir && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "7.1.2",
    "@capacitor/browser": "7.0.5",
    "@capacitor/core": "7.6.9",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/share": "7.0.4",
    "@supabase/supabase-js": "^2.112.3",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tldts": "7.0.17"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@types/chrome": "0.1.24",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "puppeteer-core": "25.14.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.5"
  }
}
