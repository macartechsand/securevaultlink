{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SecureLink Vault",
  "version": "0.1.0",
  "identifier": "app.securelink.vault.desktop",
  "build": {
    "frontendDist": "../../web-saas/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SecureLink Vault",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co https://api.pwnedpasswords.com https://*.r2.cloudflarestorage.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "appimage",
      "deb"
    ],
    "category": "Utility",
    "shortDescription": "Cofre de senhas zero-knowledge",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
