{
    "encryption": {
        "algorithm": "AES-256",
        "keySize": 256,
        "iterations": 100000,
        "saltSize": 32
    },
    "authentication": {
        "passwordPolicy": {
            "minLength": 12,
            "requireUppercase": true,
            "requireLowercase": true,
            "requireNumbers": true,
            "requireSpecialChars": true,
            "maxAge": 90,
            "preventReuse": 5
        },
        "rateLimiting": {
            "enabled": true,
            "maxAttempts": 5,
            "windowMs": 900000,
            "blockDuration": 3600000
        },
        "session": {
            "timeout": 1800000,
            "maxConcurrent": 3,
            "requireReauthForSensitive": true
        }
    },
    "api": {
        "rateLimiting": {
            "enabled": true,
            "windowMs": 900000,
            "max": 100
        },
        "cors": {
            "enabled": true,
            "allowedOrigins": ["https://securelinkvault.com"],
            "allowedMethods": ["GET", "POST", "PUT", "DELETE"],
            "maxAge": 86400
        }
    },
    "logging": {
        "level": "info",
        "sensitiveFields": [
            "password",
            "token",
            "key",
            "secret"
        ],
        "auditEvents": [
            "login",
            "logout",
            "passwordChange",
            "dataAccess",
            "configChange"
        ]
    },
    "backup": {
        "encryption": true,
        "frequency": "daily",
        "retention": 30,
        "maxBackups": 10
    },
    "monitoring": {
        "enabled": true,
        "metrics": [
            "authFailures",
            "apiLatency",
            "cryptoOperations",
            "resourceUsage"
        ],
        "alerts": {
            "authFailureThreshold": 10,
            "apiLatencyThreshold": 1000,
            "resourceUsageThreshold": 80
        }
    }
} 