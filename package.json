{
  "name": "securelink-vault",
  "version": "1.0.0",
  "description": "Gerenciador seguro de senhas",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:security": "jest --testMatch='**/*.security.test.ts'",
    "test:integration": "jest --testMatch='**/*.integration.test.ts'",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "security:check": "powershell -ExecutionPolicy Bypass -File scripts/security-check.ps1",
    "security:audit": "npm audit",
    "security:deps": "npx depcheck",
    "type-check": "tsc --noEmit",
    "ci": "npm run type-check && npm run lint && npm run test && npm run security:check"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-navigation/native": "^6.1.9",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash": "^4.17.17",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "buffer": "^6.0.3",
    "crypto-js": "^4.2.0",
    "expo": "~53.0.0",
    "expo-clipboard": "~5.0.1",
    "expo-constants": "~15.0.0",
    "expo-crypto": "~12.8.0",
    "expo-file-system": "~16.0.5",
    "expo-linking": "~6.0.0",
    "expo-local-authentication": "~13.8.0",
    "expo-router": "^3.4.7",
    "expo-secure-store": "~12.8.0",
    "expo-splash-screen": "~0.26.4",
    "expo-status-bar": "~1.11.1",
    "expo-system-ui": "~2.9.3",
    "lodash": "^4.17.21",
    "react": "18.2.0",
    "react-native": "0.73.2",
    "react-native-crypto-js": "^1.0.0",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~3.6.2",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.27.4",
    "@testing-library/react-native": "^12.4.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.2.45",
    "@types/react-native": "^0.72.8",
    "@types/zxcvbn": "^4.4.4",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-security": "^2.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.1",
    "typescript": "^5.3.0"
  },
  "private": true
}
